# ============================================================
# .gitignore global para el repo "mini-juego"
# Contiene los 4 proyectos: analizador_logs, head_laser_dog_invasion,
# normalizador_transacciones y normalizador_transacciones _skills
# ============================================================

# ---------- Python ----------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# ---------- Entornos virtuales ----------
venv/
env/
ENV/
.venv/
.python-version

# ---------- Jupyter ----------
.ipynb_checkpoints/
*.ipynb_checkpoints

# ---------- PyInstaller / pygbag ----------
# Salidas generadas por herramientas de empaquetado
build/
web-cache/
*.spec

# ---------- Exports del normalizador ----------
# Salidas generadas por la CLI (no son fuente)
exports/
!exports/.gitkeep

# ---------- Node / OpenCode ----------
node_modules/
.npm/
.pnpm-store/
package-lock.json
yarn.lock
pnpm-lock.yaml

# ---------- Secretos y variables de entorno ----------
.env
.env.*
!.env.example
*.key
*.pem
secrets.json

# ---------- Configuración de editores ----------
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ---------- Sistema operativo ----------
.DS_Store
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Desktop.ini

# ---------- Cobertura y testing ----------
.coverage
.coverage.*
htmlcov/
.pytest_cache/
.tox/
.mypy_cache/

# ---------- Logs ----------
*.log
logs/

# ---------- Datos temporales ----------
*.tmp
*.bak
*.orig
tmp/
temp/